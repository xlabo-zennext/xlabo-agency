# ── Supabase（本番DB・認証・権限）───────────────────────────
# 対象プロジェクトの URL と anon public キー。設定するとアプリはSupabaseに接続し、
# ログイン（メール+パスワード）・RLS（権限）・実データが有効になります。
# 未設定なら従来どおりデモ（インメモリ）で動作します。
# ※ service_role（secret）キーはフロントに置かないこと。
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Googleスプレッドシート反映用 Apps Script Web App の URL ──────────
# 対象シートに google-apps-script/Code.gs をデプロイして得た /exec URL を設定します。
NEXT_PUBLIC_SHEET_WEBAPP_URL=
